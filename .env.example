# --- Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mayora?schema=public"

# --- Auth / Session ---
# Generate one with:  openssl rand -base64 32
SESSION_SECRET="change-me-please-32-chars-minimum-secret"

# Session lifetime in days (optional, default 7)
SESSION_TTL_DAYS=7
